// Cloudflare Workers config for WellNest on wellnest.services.
// Each deploy first builds dist-cloudflare/ (the site with clean root addresses)
// from the GitHub Pages files in this repo; the GitHub copy is unaffected.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellnest",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node tools/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/wellnest-website", "/wellnest-website/*"]
  }
}
