// Cloudflare Workers config for WellNest on wellnest.services: the website
// (dist-cloudflare/, built from this repo's GitHub Pages files on every deploy)
// and its API backed by the D1 database "wellnest-db".
// Secrets (set in the Cloudflare dashboard, never in this file):
//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY
// Variables (set in the dashboard): ADMIN_EMAILS - who can open /admin/analytics
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wellnest",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "node tools/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wellnest-db", "database_id": "7d75ba9d-cc5f-4d23-8235-94de919602a4" }
  ],
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard (e.g. ADMIN_EMAILS) when deploying from GitHub.
  "keep_vars": true,
  // Who can open /admin/analytics: SHA-256 of each admin's lower-case email, comma-separated.
  // Make one with: printf '%s' 'you@example.com' | shasum -a 256
  "vars": { "ADMIN_EMAIL_SHA256": "29467590a4eab177c0f7df700ab22ebf8cf0973b20074e961628ab27a9633fa0" }
}
